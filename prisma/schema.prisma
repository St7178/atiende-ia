generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Advisor {
  id           Int            @id @default(autoincrement())
  name         String
  // Correo de Google con el que puede iniciar sesion (opcional).
  email        String?        @unique
  username     String?        @unique
  passwordHash String?        @map("password_hash")
  // "admin" administra asesores; "asesor" atiende chats.
  role         String         @default("asesor")
  avatarColor  String         @default("#6C5CE7") @map("avatar_color")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  conversations Conversation[]
  messages     Message[]

  @@map("advisors")
}

model Conversation {
  waId              String    @id @map("wa_id")
  contactName       String?   @map("contact_name")
  status            String    @default("bot")
  pipelineStage      String    @default("nuevo") @map("pipeline_stage")
  assignedAdvisorId Int?      @map("assigned_advisor_id")
  assignedAdvisor   Advisor?  @relation(fields: [assignedAdvisorId], references: [id])
  lastMessageAt     DateTime  @default(now()) @map("last_message_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  messages          Message[]

  @@map("conversations")
  @@index([pipelineStage])
}

model Message {
  id           BigInt        @id @default(autoincrement())
  waId         String?       @map("wa_id")
  conversation Conversation? @relation(fields: [waId], references: [waId])
  wamid        String?
  sender       String
  advisorId    Int?          @map("advisor_id")
  advisor      Advisor?      @relation(fields: [advisorId], references: [id])
  body         String?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("messages")
  @@index([waId])
}

model CompanyKnowledge {
  id            Int      @id @default(autoincrement())
  knowledgeText String   @map("knowledge_text")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@map("company_knowledge")
}
