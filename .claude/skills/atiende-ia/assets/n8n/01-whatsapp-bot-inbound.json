    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into conversations (wa_id, contact_name, status, pipeline_stage, assigned_advisor_id, last_message_at)\nvalues ($1, $2, 'bot', 'nuevo', null, now())\non conflict (wa_id) do update set\n  contact_name = excluded.contact_name,\n  last_message_at = now(),\n  status = case when conversations.status = 'resuelto' then 'bot' else conversations.status end,\n  pipeline_stage = case when conversations.status = 'resuelto' then 'nuevo' else conversations.pipeline_stage end,\n  assigned_advisor_id = case when conversations.status = 'resuelto' then null else conversations.assigned_advisor_id end\nreturning wa_id, status, pipeline_stage, assigned_advisor_id;",
        "options": {
          "queryReplacement": "={{ [$json.wa_id, $json.contact_name] }}"
        }
      },
