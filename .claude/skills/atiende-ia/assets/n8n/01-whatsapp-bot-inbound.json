    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst entry = body.entry && body.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst value = change && change.value;\nconst msg = value && value.messages && value.messages[0];\n\nif (!msg) {\n  return [];\n}\n\nconst contact = (value.contacts && value.contacts[0]) || {};\nconst phone = msg.from;\nconst name = contact.profile ? contact.profile.name : phone;\nconst type = msg.type;\nconst text = type === 'text' ? msg.text.body : (type === 'button' ? msg.button.text : '');\n\nreturn [{\n  json: {\n    wa_id: phone,\n    contact_name: name,\n    wamid: msg.id,\n    message_type: type,\n    message_text: text,\n    timestamp: msg.timestamp\n  }\n}];"
      },
      "id": "926e4867-fc1a-4285-b0d3-0d38a336d64b",
      "name": "Normalizar mensaje",
