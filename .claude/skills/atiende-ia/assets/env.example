# Base de datos Postgres (Neon, Supabase o Vercel Postgres - cualquiera funciona con Prisma)
DATABASE_URL="postgresql://user:password@host:5432/atiendeia?sslmode=require"

# URL del webhook de n8n que envia el mensaje del asesor por WhatsApp
# (workflow "02-portal-outbound-asesor.json", nodo "Webhook - Portal envia mensaje")
N8N_PORTAL_SEND_WEBHOOK_URL="https://tu-instancia-n8n.com/webhook/portal-send-message"

# Debe coincidir con PORTAL_WEBHOOK_SECRET configurado en n8n (header x-portal-token)
PORTAL_WEBHOOK_SECRET="cambia-este-valor"

# Credenciales maestras del administrador en /login (ver proxy.ts). Al entrar con
# ellas se crea la cuenta "admin". Los demas asesores los crea el admin en la
# pagina Asesores, con su propio usuario y contraseña.
# Si se dejan vacios (desarrollo local), el portal queda abierto.
PORTAL_USER="admin"
PORTAL_PASSWORD="cambia-este-valor"

# Llave para firmar la cookie de sesion (si se omite se usa PORTAL_PASSWORD)
SESSION_SECRET="una-cadena-larga-y-aleatoria"

# Opcional: iniciar sesion con Google. Crea un "OAuth client ID" (Web) en
# Google Cloud Console con la URI de redireccion
# https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Llamadas con IA (ElevenLabs Agents). Ver elevenlabs/agente-ventas.md
# Proveedor del numero importado en ElevenLabs: "sip_trunk" (por defecto) o "twilio"
ELEVENLABS_PHONE_PROVIDER="sip_trunk"
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_PHONE_NUMBER_ID=""
ELEVENLABS_WEBHOOK_SECRET=""
